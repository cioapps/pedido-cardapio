# Secrets das Edge Functions (supabase secrets set --env-file supabase/functions/.env)
UAZAPI_URL=https://seu-servidor.uazapi.com
UAZAPI_ADMIN_TOKEN=seu-admintoken
ANTHROPIC_API_KEY=sua-chave-anthropic
# Opcional: modelo da IA (padrão claude-opus-5-5). Ex.: claude-sonnet-5-5 para reduzir custo
MODELO_IA=
# Opcional: chave OpenAI para a uazapi transcrever áudios
OPENAI_API_KEY=
# Opcional: segundos sem mensagem nova antes de a IA analisar (padrão 20000 ms)
ESPERA_ANALISE_MS=20000

# Push: JSON da conta de serviço do Firebase (numa linha) e o segredo do gatilho do banco
FIREBASE_SERVICE_ACCOUNT=
PUSH_SEGREDO=
